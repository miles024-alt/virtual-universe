{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run OMNIVERSE",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Open OMNIVERSE Browser Sandbox",
      "type": "shell",
      "command": "python3 -m http.server 4173 --directory \"${workspaceFolder}/web\"",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
